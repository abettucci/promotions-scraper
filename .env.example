# ===========================================
# Configuración del Scraper de Promociones
# ===========================================
# Copia este archivo a .env y configura tus valores

# API Key de Anthropic (requerida para modo --ai)
# Obtén tu API key en: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key

# Modelo de Claude a usar (opcional)
# Opciones: claude-sonnet-4-20250514, claude-3-5-sonnet-20241022, claude-3-haiku-20240307
# AI_MODEL=claude-sonnet-4-20250514

# Máximo de tokens en respuesta de IA (opcional)
# AI_MAX_TOKENS=4096

# Máximo de screenshots por página (opcional)
# AI_MAX_SCREENSHOTS=5

# Debug mode - guarda screenshots de debug
# DEBUG_SCRAPER=true

# Usar scraper simple para Carrefour (sin Playwright)
# USE_SIMPLE_SCRAPER=false
