# ===========================================
# Configuración del Scraper de Promociones
# ===========================================
# Copia este archivo a .env y configura tus valores

# API Key de Anthropic (requerida para modo --ai)
# Obtén tu API key en: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key

# Modelo de Claude a usar (opcional)
# Opciones: claude-sonnet-4-20250514, claude-3-5-sonnet-20241022, claude-3-haiku-20240307
# AI_MODEL=claude-sonnet-4-20250514

# Máximo de tokens en respuesta de IA (opcional)
# AI_MAX_TOKENS=4096

# Máximo de screenshots por página (opcional)
# AI_MAX_SCREENSHOTS=5

# Debug mode - guarda screenshots de debug
# DEBUG_SCRAPER=true

# Usar scraper simple para Carrefour (sin Playwright)
# USE_SIMPLE_SCRAPER=false

# ===========================================
# Notificaciones Telegram
# ===========================================
# 1. Habla con @BotFather en Telegram → /newbot → copiá el token
TELEGRAM_BOT_TOKEN=123456789:ABCDefgh...

# 2. Habla con @userinfobot en Telegram para obtener tu chat ID
#    O agregá el bot a un grupo y usá el ID del grupo (negativo, ej: -1001234567890)
TELEGRAM_CHAT_ID=123456789

# Si True, envía notificación automáticamente al terminar cada scrape
# TELEGRAM_NOTIFY_ON_SCRAPE=false

# Si True, el digest incluye solo promos válidas para el día de hoy
# TELEGRAM_TODAY_ONLY=true

# ===========================================
# Autenticación JWT
# ===========================================
# Generá un secreto seguro con: openssl rand -hex 32
JWT_SECRET=cambia-esto-por-un-secreto-seguro
